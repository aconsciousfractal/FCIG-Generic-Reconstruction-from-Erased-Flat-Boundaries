LIB "elim.lib";
option(redSB);
ring R = 0, (x12,x13,x14,x23,x24,x34), dp;
poly e0 = x12^2*x34^2 - x12^2 + 2*x12*x13*x23 - 2*x12*x13*x24*x34 - 2*x12*x14*x23*x34 + 2*x12*x14*x24 + x13^2*x24^2 - x13^2 - 2*x13*x14*x23*x24 + 2*x13*x14*x34 + x14^2*x23^2 - x14^2 - x23^2 + 2*x23*x24*x34 - x24^2 - x34^2 + 1;
poly e1 = 8*x23^2 - 18*x23*x24*x34 + 2*x23*x24 + 2*x23*x34 - 2*x23 + 8*x24^2 + 2*x24*x34 - 2*x24 + 8*x34^2 - 2*x34 - 6;
poly e2 = 8*x13^2 - 18*x13*x14*x34 + 2*x13*x14 + 2*x13*x34 - 2*x13 + 8*x14^2 + 2*x14*x34 - 2*x14 + 8*x34^2 - 2*x34 - 6;
poly e3 = 8*x12^2 - 18*x12*x14*x24 + 2*x12*x14 + 2*x12*x24 - 2*x12 + 8*x14^2 + 2*x14*x24 - 2*x14 + 8*x24^2 - 2*x24 - 6;
poly e4 = 8*x12^2 - 18*x12*x13*x23 + 2*x12*x13 + 2*x12*x23 - 2*x12 + 8*x13^2 + 2*x13*x23 - 2*x13 + 8*x23^2 - 2*x23 - 6;
poly dg1 = -x23^2 + 2*x23*x24*x34 - x24^2 - x34^2 + 1;
poly dg2 = -x13^2 + 2*x13*x14*x34 - x14^2 - x34^2 + 1;
poly dg3 = -x12^2 + 2*x12*x14*x24 - x14^2 - x24^2 + 1;
poly dg4 = -x12^2 + 2*x12*x13*x23 - x13^2 - x23^2 + 1;
poly s1 = x12*x23*x34 - x12*x23 + x12*x24*x34 - x12*x24 - x12*x34^2 + x12 + x13*x23*x24 - x13*x23 - x13*x24^2 + x13*x24*x34 - x13*x34 + x13 - x14*x23^2 + x14*x23*x24 + x14*x23*x34 - x14*x24 - x14*x34 + x14 + x23^2 - 2*x23*x24*x34 + x24^2 + x34^2 - 1;
poly s2 = x12*x13*x34 - x12*x13 + x12*x14*x34 - x12*x14 - x12*x34^2 + x12 - x13^2*x24 + x13^2 + x13*x14*x23 + x13*x14*x24 - 2*x13*x14*x34 - x13*x23 + x13*x24*x34 - x14^2*x23 + x14^2 + x14*x23*x34 - x14*x24 - x23*x34 + x23 - x24*x34 + x24 + x34^2 - 1;
poly s3 = -x12^2*x34 + x12^2 + x12*x13*x24 - x12*x13 + x12*x14*x23 - 2*x12*x14*x24 + x12*x14*x34 - x12*x23 + x12*x24*x34 + x13*x14*x24 - x13*x14 - x13*x24^2 + x13 - x14^2*x23 + x14^2 + x14*x23*x24 - x14*x34 - x23*x24 + x23 + x24^2 - x24*x34 + x34 - 1;
poly s4 = -x12^2*x34 + x12^2 - 2*x12*x13*x23 + x12*x13*x24 + x12*x13*x34 + x12*x14*x23 - x12*x14 + x12*x23*x34 - x12*x24 - x13^2*x24 + x13^2 + x13*x14*x23 - x13*x14 + x13*x23*x24 - x13*x34 - x14*x23^2 + x14 + x23^2 - x23*x24 - x23*x34 + x24 + x34 - 1;
proc satpoly(ideal Q0, poly f) {
  ideal Q = std(Q0);
  while (1) {
    ideal Qn = std(quotient(Q, ideal(f)));
    if (size(reduce(Qn, Q)) == 0) { return(Q); }
    Q = Qn;
  }
}
ideal I = e0,e1,e2,e3,e4;
ideal J = std(I);
"dim before saturation:", dim(J);
ideal S = J;
S = satpoly(S, dg1);
S = satpoly(S, dg2);
S = satpoly(S, dg3);
S = satpoly(S, dg4);
S = satpoly(S, s1);
S = satpoly(S, s2);
S = satpoly(S, s3);
S = satpoly(S, s4);
S = std(S);
"dim after saturation:", dim(S);
"is <1>:", size(reduce(1, S)) == 0;
"GB size:", size(S);
"J contained in S:", size(reduce(J, S)) == 0;
"globally saturated (0 = yes):", size(reduce(quotient(S, ideal(dg1)), S)) + size(reduce(quotient(S, ideal(dg2)), S)) + size(reduce(quotient(S, ideal(dg3)), S)) + size(reduce(quotient(S, ideal(dg4)), S)) + size(reduce(quotient(S, ideal(s1)), S)) + size(reduce(quotient(S, ideal(s2)), S)) + size(reduce(quotient(S, ideal(s3)), S)) + size(reduce(quotient(S, ideal(s4)), S));
map ev = R, -1/3,-1/3,-1/3,-1/3,-1/3,-1/3;
ideal Sval = ev(S);
"regular point on saturated variety (0 = yes):", size(simplify(Sval, 2));
write(":w p43_h13_gb.txt", string(S));
ring Rt0 = 0, (x12,x13,x14,x23,x24,x34,t), dp;
ideal St = imap(R, S);
St = St, 1 - t*(x12-x34);
"linear form x12-x34 in radical (1 = yes):", size(reduce(1, std(St))) == 0;
setring R;
ring Rt1 = 0, (x12,x13,x14,x23,x24,x34,t), dp;
ideal St = imap(R, S);
St = St, 1 - t*(x13-x24);
"linear form x13-x24 in radical (1 = yes):", size(reduce(1, std(St))) == 0;
setring R;
ring Rt2 = 0, (x12,x13,x14,x23,x24,x34,t), dp;
ideal St = imap(R, S);
St = St, 1 - t*(x14-x23);
"linear form x14-x23 in radical (1 = yes):", size(reduce(1, std(St))) == 0;
setring R;
quit;
